# CrowdWisdomTrading Quant Environment Configuration
# Copy this file to .env and insert your API keys:
# cp .env.example .env

# 1. Apify Configuration (X / Twitter Scraping)
# Sign up at https://apify.com to obtain your API token
APIFY_TOKEN=your_apify_token_here
# Recommended Apify Actor ID for Twitter scraping (e.g., apidojo/tweet-scraper or vdrmmr/twitter-scraper)
APIFY_ACTOR_ID=apidojo/tweet-scraper

# 2. Tavily Configuration (Recent & Breaking News Ingestion)
# Sign up at https://tavily.com to obtain your API key
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Exa Configuration (Alternative Search Engine - Optional)
# Sign up at https://exa.ai to obtain your API key
EXA_API_KEY=your_exa_api_key_here

# 4. Pipeline Settings
DEFAULT_ASSET=BTC-USD
DATA_LOOKBACK_DAYS=180
BAR_TIMEFRAME=1h
DB_PATH=data/crowdwisdom.duckdb
USE_OFFLINE_FALLBACK_IF_NO_KEY=true
